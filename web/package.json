{
  "name": "matheran-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "npm run build && npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy"
  }
}

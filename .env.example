# Copy to .env, or just let the Setup tab in the console create it for you.
# The console writes this file at mode 0600 and never sends values back to the browser.
# Never commit .env.

# ---- This service ----
# Protects the console and API. Generate one from the Setup tab, or:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required if you bind to anything other than 127.0.0.1.
MATHERAN_API_KEY=

# ---- Dhan (DhanHQ v2) ----
# web.dhan.co -> My Profile -> Access DhanHQ APIs. Token lasts 24 hours.
# Order placement also needs a static IP whitelisted on your Dhan account.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ---- Stoxkart (Superr API) ----
# App key/secret from superrapi.stoxkart.com or Stoxkart support.
# Adapter is partial: market data falls back to another provider, live orders disabled.
STOXKART_CLIENT_ID=
STOXKART_API_KEY=
STOXKART_API_SECRET=
STOXKART_PASSWORD=

# ---- Upstox (market data) ----
# NOT REQUIRED. Upstox candle endpoints need no authentication, so free market data
# works with this blank. Setting a token only upgrades the price feed from
# "last 1-minute close" to live tick LTP. Generate one at Upstox developer apps.
UPSTOX_ACCESS_TOKEN=
